<?xml version="1.0" encoding="utf-8"?>
<!--
  Правила переноса и облачного резервного копирования (Android 12+).
  База рецептов и черновики ввода восстанавливаются при переустановке
  и переносятся при смене телефона.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="family-recipes.db" />
        <include domain="database" path="family-recipes.db-wal" />
        <include domain="database" path="family-recipes.db-shm" />
        <include domain="sharedpref" path="drafts.xml" />
        <include domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="family-recipes.db" />
        <include domain="database" path="family-recipes.db-wal" />
        <include domain="database" path="family-recipes.db-shm" />
        <include domain="sharedpref" path="drafts.xml" />
        <include domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
